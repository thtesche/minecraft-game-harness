# Copy to .env and fill in. `.env` is gitignored; this file is tracked, so it
# must never contain a real key.
#
#   cp .env.example .env
#
# The harness reads the key from the environment, not from this file, so the
# key has to be exported too. direnv, `set -a; . ./.env; set +a`, or an `export`
# in your shell profile all work; `run-loop` says so by name if it is missing.

# OpenRouter API key. https://openrouter.ai/keys
OPENROUTER_API_KEY=